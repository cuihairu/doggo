{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Server=localhost;Port=3306;Database=doggo;User=doggo;Password=change-me;",
    "Redis": "localhost:6379"
  },
  "Scraper": {
    "ScanIntervalSeconds": 300,
    "CircuitFailureThreshold": 5,
    "CircuitCooldownMinutes": 30,
    "FetchTimeoutSeconds": 60,
    "EnablePlaywright": false,
    "SeedDefaultSources": true,
    "ImageProxyBaseUrl": ""
  },
  "PriceCrawler": {
    "Enabled": true,
    "ScanIntervalSeconds": 300,
    "GlobalConcurrentFetches": 8,
    "FetchTimeoutSeconds": 60,
    "MaxItemsPerRun": 200,
    "RawRetentionDays": 90,
    "Sites": [
      {
        "Key": "example-market",
        "Enabled": false,
        "IntervalMinutes": 60,
        "MarketHashNames": [],
        "Html": {
          "BaseUrl": "",
          "SearchPathTemplate": "/search?q={query}",
          "DetailPathTemplate": "/item/{id}",
          "ItemSelector": ".market-item",
          "ItemIdAttribute": "data-id",
          "TitleSelector": ".name",
          "PriceSelector": ".price",
          "CurrencyCode": "CNY"
        }
      }
    ]
  }
}
