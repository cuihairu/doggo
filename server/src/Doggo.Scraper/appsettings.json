{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Server=localhost;Port=3306;Database=doggo;User=doggo;Password=change-me;",
    "Redis": "localhost:6379"
  },
  "Scraper": {
    "ScanIntervalSeconds": 300,
    "CircuitFailureThreshold": 5,
    "CircuitCooldownMinutes": 30,
    "FetchTimeoutSeconds": 60,
    "EnablePlaywright": false,
    "SeedDefaultSources": true,
    "ImageProxyBaseUrl": ""
  }
}
