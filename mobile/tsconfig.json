{
  "compilerOptions": {
    "target": "es2017",
    "module": "esnext",
    "moduleResolution": "node",
    "lib": ["dom", "es2017"],
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@tarojs/taro": ["node_modules/@tarojs/taro"],
      "@tarojs/components": ["node_modules/@tarojs/components"]
    },
    "typeRoots": ["node_modules/@types"],
    "types": ["node"]
  },
  "include": ["src", "config", "../shared/src"],
  "exclude": ["node_modules", "dist"]
}
