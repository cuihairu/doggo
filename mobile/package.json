{
  "name": "doggo-mobile",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "description": "Doggo mobile app (Taro RN + React Native)",
  "scripts": {
    "dev:rn": "taro build --type rn --watch",
    "build:rn": "taro build --type rn",
    "typecheck": "tsc --noEmit",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@doggo/shared": "link:../shared",
    "@react-native-async-storage/async-storage": "1.21.0",
    "@react-native/assets-registry": "0.73.1",
    "@react-native/metro-config": "0.73.5",
    "@tarojs/components-rn": "4.3.0",
    "@tarojs/helper": "4.3.0",
    "@tarojs/plugin-framework-react": "4.3.0",
    "@tarojs/react": "4.3.0",
    "@tarojs/rn-supporter": "4.3.0",
    "@tarojs/runtime-rn": "4.3.0",
    "@tarojs/shared": "4.3.0",
    "@tarojs/taro": "4.3.0",
    "@tarojs/taro-rn": "4.3.0",
    "babel-plugin-global-define": "1.0.3",
    "babel-plugin-jsx-attributes-array-to-object": "0.3.0",
    "babel-plugin-transform-react-jsx-to-rn-stylesheet": "4.3.0",
    "expo": "~50.0.2",
    "expo-asset": "9.0.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.73.6",
    "react-native-gesture-handler": "2.14.1",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "3.29.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@react-native/babel-preset": "0.73.21",
    "@tarojs/cli": "4.3.0",
    "@tarojs/components": "4.3.0",
    "@tarojs/rn-runner": "4.3.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "babel-preset-taro": "4.3.0",
    "typescript": "^5.5.0"
  }
}
