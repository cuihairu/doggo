# Copy to deploy/.env and fill in the values. Never commit the real .env.
# Required
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# 64+ random bytes, e.g. openssl rand -base64 48
AUTH_SECRET_KEY=

# Optional (defaults shown)
MYSQL_DATABASE=doggo
MYSQL_USER=doggo
WEB_PORT=8080
ADMIN_PORT=8081
API_PORT=8082

# Vapor order fulfillment integration (leave empty to disable)
VAPOR_BASE_URL=
VAPOR_API_KEY=
VAPOR_WEBHOOK_SECRET=
VAPOR_DEFAULT_TARGET=

# WeChat miniapp login (leave empty to return 503 on /api/auth/wechat)
WECHAT_APP_ID=
WECHAT_APP_SECRET=
